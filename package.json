{
  "name": "@unoverse-platform/base",
  "version": "0.3.39",
  "description": "The Unoverse YAML runtime: node manifests, rx definitions, and the platform surface a node sees",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoverse-platform/base.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./package.json": "./package.json",
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc && node scripts/copy-lint.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "prepublishOnly": "npm run test && npm run build",
    "prepack": "node scripts/publish-fields.mjs apply",
    "postpack": "node scripts/publish-fields.mjs restore"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@cfworker/json-schema": "^4.1.1",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@smithy/protocol-http": "^5.5.14",
    "@smithy/signature-v4": "^5.6.10",
    "acorn": "^8.17.0",
    "fast-memoize": "^2.5.2",
    "fast-xml-parser": "^5.2.5",
    "gray-matter": "^4.0.3",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.0",
    "jose": "^5.9.6",
    "lucide": "^1.21.0",
    "ws": "^8.18.0",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json",
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "homepage": "https://github.com/unoverse-platform/base#readme",
  "bugs": {
    "url": "https://github.com/unoverse-platform/base/issues"
  },
  "devDependencies": {
    "@types/ws": "^8.5.13",
    "uWebSockets.js": "github:uNetworking/uWebSockets.js#v20.44.0"
  },
  "peerDependencies": {
    "uWebSockets.js": "*"
  },
  "peerDependenciesMeta": {
    "uWebSockets.js": {
      "optional": true
    }
  }
}
