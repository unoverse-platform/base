{
  "name": "@unoverse-platform/base",
  "version": "0.1.1",
  "description": "The node runtime: manifests, the platform surface a node sees, and plugin loading",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unoverse-platform/base.git"
  },
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.js": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    },
    "./*": {
      "types": "./src/*.ts",
      "default": "./src/*.ts"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/util-dynamodb": "^3.996.7",
    "@smithy/protocol-http": "^5.5.14",
    "@smithy/signature-v4": "^5.6.10",
    "acorn": "^8.17.0",
    "fast-memoize": "^2.5.2",
    "fast-xml-parser": "^5.2.5",
    "handlebars": "^4.7.8",
    "ioredis": "^5.3.0",
    "yaml": "^2.8.1"
  },
  "publishConfig": {
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*.js": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      }
    }
  },
  "homepage": "https://github.com/unoverse-platform/base#readme",
  "bugs": {
    "url": "https://github.com/unoverse-platform/base/issues"
  }
}
